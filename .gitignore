# Terraform
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terraform variable values - may contain environment-specific or sensitive data.
# Commit terraform.tfvars.example instead.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# uv
.uv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build artifacts
build/
dist/

# Credentials and secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials
credentials.csv
*_accessKeys.csv

# Scratch files from CLI experimentation
converse.json
response.json

# Local corpus - PDFs are not redistributable and are large.
# Corpus is documented by DOI list in docs/, not committed.
corpus/*
!corpus/manifest.csv
!corpus/query.json
data/raw/

# Editors
.vscode/
.idea/
*.swp

# OS
Thumbs.db
Desktop.ini
.DS_Store
